# Production secrets are injected by Portainer/secret manager.
# Do not put real credentials in this file.
NODE_ENV=production
APP_URL=https://api.rahatio.com.tr
CORS_ORIGIN=https://rahatio.com.tr,https://admin.rahatio.com.tr
DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<database>
REDIS_URL=redis://redis:6379
JWT_SECRET=<set-in-secret-manager>
JWT_REFRESH_SECRET=<set-in-secret-manager>
RAHAT_INTERNAL_KEY=<set-in-secret-manager>
RAHAT_SLAVE_HMAC_SECRET=<set-in-secret-manager>
CORE_API_KEY=<set-in-secret-manager>
POSTGRES_USER=<set-in-secret-manager>
POSTGRES_PASSWORD=<set-in-secret-manager>
POSTGRES_DB=rahatio
MINIO_ROOT_USER=<set-in-secret-manager>
MINIO_ROOT_PASSWORD=<set-in-secret-manager>
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rahatio-media
AI_SERVICE_URL=http://ai-service:3001
INTEGRATION_SERVICE_URL=http://integration-service:3002
VERCEL_TOKEN=placeholder-change-me
VERCEL_TEAM_ID=placeholder-change-me
