# Core API
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rahatio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rahatio

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Internal API Key
RAHAT_INTERNAL_KEY=internal-secret-key-change-in-production
RAHAT_SLAVE_HMAC_SECRET=slave-hmac-secret-change-in-production
CORE_API_KEY=core-internal-key

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rahatio-media
PUBLIC_MEDIA_URL=https://api.rahatio.com.tr

# Stripe — SAAS (platformun kendi hesabı, abonelik + AI kredi tahsilatı)
# Satıcı storefront Stripe anahtarları BURAYA KONMAZ — satıcı kendi sk_/whsec_ anahtarlarını
# Admin Panel > Ödeme Yöntemleri > Stripe ayarından girer (DB: store_payment_methods.config).
# STRIPE_SECRET_KEY = Stripe Dashboard > Developers > API keys > Secret key (sk_live_... / sk_test_...)
# STRIPE_WEBHOOK_SECRET = Stripe Dashboard > Developers > Webhooks > Add endpoint > https://api.rahatio.com.tr/api/admin/webhook/stripe > Reveal signing secret (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Service
AI_SERVICE_URL=http://localhost:3001

# Integration Service
INTEGRATION_SERVICE_URL=http://localhost:3002

# Marketplace APIs (optional - can be set per store)
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
TRENDYOL_SUPPLIER_ID=
HEPSIBURADA_USERNAME=
HEPSIBURADA_PASSWORD=
HEPSIBURADA_MERCHANT_ID=
PAZARAMA_CLIENT_ID=
PAZARAMA_CLIENT_SECRET=
PAZARAMA_API_KEY=
N11_APPKEY=
N11_APPSECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_AWS_ACCESS_KEY=
AMAZON_AWS_SECRET_KEY=
AMAZON_SELLER_ID=
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=

# AI Service
OLLAMA_URL=http://localhost:11434
COMFY_URL=http://localhost:8188
GOOGLE_CLOUD_VISION_API_KEY=

# Meta (Facebook/Instagram) — TechProvider App (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata,instagram_basic,instagram_content_publish,catalog_management,business_management
# For TechProvider after Business verification + App Review add: ,ads_management,manage_business_extension
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000