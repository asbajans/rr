{
  "expo": {
    "name": "Rahatio",
    "slug": "rahatio",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "rahatio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahatio.mobile",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.rahatio.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F7F7"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rahatio needs access to your photos to process images with AI."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/coin.wav"]
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "apiUrl": "https://api.rahatio.com.tr",
      "eas": {
        "projectId": "6bb13aed-b1f2-482f-9327-86b5eb6c6315"
      }
    },
    "owner": "ahmedsaidbuluts-team",
    "updates": {
      "url": "https://u.expo.dev/6bb13aed-b1f2-482f-9327-86b5eb6c6315"
    }
  }
}